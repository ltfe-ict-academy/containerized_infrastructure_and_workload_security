# Optional observability overrides. The Compose file already contains safe local defaults.
# Copy selected values into .env if you want to change host bindings, ports, or image tags.

OBS_BIND=127.0.0.1
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
CADVISOR_PORT=8081
ALLOY_PORT=12345
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
DOCKHAND_PORT=3002
PORTAINER_PORT=9443

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=course-observe-change-me
PROMETHEUS_RETENTION=7d

# For production or shared labs, pin versions or digests instead of using latest.
# GRAFANA_IMAGE=grafana/grafana:<version-or-digest>
# PROMETHEUS_IMAGE=prom/prometheus:<version-or-digest>
# LOKI_IMAGE=grafana/loki:<version-or-digest>
# TEMPO_IMAGE=grafana/tempo:<version-or-digest>
# ALLOY_IMAGE=grafana/alloy:<version-or-digest>
# CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:<version-or-digest>
# NODE_EXPORTER_IMAGE=prom/node-exporter:<version-or-digest>
# BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:<version-or-digest>
# FALCO_IMAGE=falcosecurity/falco:0.44.0
# DOCKHAND_IMAGE=fnsys/dockhand:latest
# PORTAINER_IMAGE=portainer/portainer-ce:latest
# BEYLA_IMAGE=grafana/beyla:<version-or-digest>
