{
  "uid": "alloy-app-logs",
  "title": "Alloy: Application Logs",
  "tags": [
    "container-security-course",
    "alloy",
    "logs",
    "loki",
    "application"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({compose_project=\"example_app_final\"}, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "sort": 1
      },
      {
        "name": "level",
        "label": "Log Level",
        "type": "custom",
        "query": "all,error,warn,info,debug",
        "includeAll": false,
        "current": { "text": "all", "value": "all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Alloy — Log Lines Forwarded to Loki (rate)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_write_sent_entries_total{job=\"alloy\"}[1m]))",
          "legendFormat": "entries/s forwarded"
        }
      ],
      "description": "Rate of log entries Alloy is successfully sending to Loki.",
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 8, "lineWidth": 1 }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Alloy — Loki Write Errors",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_write_dropped_entries_total{job=\"alloy\"}[1m]))",
          "legendFormat": "dropped entries/s"
        }
      ],
      "description": "Log entries dropped by Alloy (Loki unreachable or rate-limited). Non-zero means log loss.",
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1,
            "thresholdsStyle": { "mode": "area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Log Volume by Service",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({compose_project=\"example_app_final\", service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "description": "Log line rate per application service.",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 6, "lineWidth": 1 }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Error / Warning Rate by Service",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({compose_project=\"example_app_final\", service=~\"$service\"} |~ \"(?i)(error|err|critical|fatal|exception|traceback|panic)\" [1m]))",
          "legendFormat": "errors — {{service}}"
        },
        {
          "refId": "B",
          "expr": "sum by (service) (count_over_time({compose_project=\"example_app_final\", service=~\"$service\"} |~ \"(?i)(warn|warning)\" [1m]))",
          "legendFormat": "warnings — {{service}}"
        }
      ],
      "description": "Count of lines containing error/warning keywords per service.",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 1 }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "errors.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "warnings.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      }
    },
    {
      "id": 5,
      "title": "reverse-proxy logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_project=\"example_app_final\", service=\"reverse-proxy\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 6,
      "title": "backend logs",
      "type": "logs",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_project=\"example_app_final\", service=\"backend\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 7,
      "title": "frontend logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_project=\"example_app_final\", service=\"frontend\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 8,
      "title": "db / redis logs",
      "type": "logs",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_project=\"example_app_final\", service=~\"db|redis\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 9,
      "title": "All Services — Error & Warning Lines",
      "type": "logs",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_project=\"example_app_final\", service=~\"$service\"} |~ \"(?i)(error|err|critical|fatal|exception|traceback|panic|warn|warning)\""
        }
      ],
      "description": "Filtered view: only lines containing error/warning keywords across all selected services.",
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 10,
      "title": "Alloy Component Errors",
      "type": "logs",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"alloy\"} |~ \"(?i)(error|warn|fail|drop)\""
        }
      ],
      "description": "Alloy's own error logs — useful for diagnosing log collection or Loki connectivity issues.",
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
