{
  "uid": "monitoring-health",
  "title": "Monitoring Stack: Component Health",
  "description": "Live status for every observability component. Green = reachable / running. N/A = not deployed or not yet scraped.",
  "tags": ["container-security-course", "monitoring", "health", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    { "id": 1, "title": "Prometheus", "type": "stat", "gridPos": { "x": 0, "y": 0, "w": 3, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "up{job=\"prometheus\"}", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }, "overrides": [] } },
    { "id": 2, "title": "Loki", "type": "stat", "gridPos": { "x": 3, "y": 0, "w": 3, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "up{job=\"loki\"}", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }, "overrides": [] } },
    { "id": 3, "title": "Tempo", "type": "stat", "gridPos": { "x": 6, "y": 0, "w": 3, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "up{job=\"tempo\"}", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }, "overrides": [] } },
    { "id": 4, "title": "Alloy", "type": "stat", "gridPos": { "x": 9, "y": 0, "w": 3, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "up{job=\"alloy\"}", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }, "overrides": [] } },
    { "id": 5, "title": "Grafana", "type": "stat", "gridPos": { "x": 12, "y": 0, "w": 3, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "up{job=\"grafana\"}", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }, "overrides": [] } },
    { "id": 6, "title": "cAdvisor", "type": "stat", "gridPos": { "x": 15, "y": 0, "w": 3, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "up{job=\"cadvisor\"}", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }, "overrides": [] } },
    { "id": 7, "title": "Node Exporter", "type": "stat", "gridPos": { "x": 18, "y": 0, "w": 3, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "up{job=\"node-exporter\"}", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }, "overrides": [] } },
    { "id": 10, "title": "Blackbox Exporter", "description": "up=1 for app-http-probes means Prometheus can reach blackbox-exporter. Per-endpoint results are in the Blackbox dashboard.", "type": "stat", "gridPos": { "x": 4, "y": 3, "w": 4, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "min(up{job=\"app-http-probes\"})", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }, "overrides": [] } },
    { "id": 11, "title": "App /healthz probe", "description": "probe_success for the reverse-proxy /healthz endpoint.", "type": "stat", "gridPos": { "x": 8, "y": 3, "w": 4, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "probe_success{instance=~\".*healthz.*\"}", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }, "overrides": [] } },
    { "id": 12, "title": "App /api/health probe", "description": "probe_success for the backend /api/health endpoint.", "type": "stat", "gridPos": { "x": 12, "y": 3, "w": 4, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "probe_success{instance=~\".*api/health.*\"}", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }, "overrides": [] } },
    { "id": 13, "title": "Falco container", "description": "cAdvisor still sees the Falco container running. N/A = cAdvisor not running or Falco not started.", "type": "stat", "gridPos": { "x": 16, "y": 3, "w": 4, "h": 3 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "refId": "A", "expr": "count(container_last_seen{container_label_com_docker_compose_service=\"falco\"})", "instant": true, "legendFormat": "" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value", "graphMode": "none" }, "fieldConfig": { "defaults": { "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "range", "options": { "from": 1, "to": 999, "result": { "text": "UP", "color": "green", "index": 0 } } }, { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 1 } } }] }, "overrides": [] } },
    {
      "id": 15, "title": "Scrape Target UP Status — Over Time", "description": "1 = reachable, 0 = scrape failed. Any dip warrants investigation.", "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job!=\"app-http-probes\"}", "legendFormat": "{{job}}" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1.1, "custom": { "fillOpacity": 6, "lineWidth": 2, "drawStyle": "line", "spanNulls": false } }, "overrides": [] }
    },
    {
      "id": 16, "title": "App Probe Success — Over Time", "description": "1 = HTTP 2xx, 0 = failed. Source: blackbox-exporter.", "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "probe_success{job=\"app-http-probes\"}", "legendFormat": "{{instance}}" }],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1.1, "custom": { "fillOpacity": 10, "lineWidth": 2, "drawStyle": "line" } }, "overrides": [] }
    },
    {
      "id": 17, "title": "Scrape Duration by Component", "description": "How long each Prometheus scrape takes. Values consistently above 5 s indicate slow or overloaded targets.", "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "scrape_duration_seconds{job!=\"app-http-probes\"}", "legendFormat": "{{job}}" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 4, "lineWidth": 1, "drawStyle": "line" } }, "overrides": [] }
    },
    {
      "id": 18, "title": "All Prometheus Targets", "description": "Instant up/down for every configured scrape target. Status is colour-coded.", "type": "table",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "up", "instant": true, "legendFormat": "", "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "Value": "Status", "job": "Component", "instance": "Target" }, "indexByName": { "Component": 0, "Target": 1, "Status": 2 } } }],
      "options": { "sortBy": [{ "displayName": "Component", "desc": false }], "footer": { "show": false } },
      "fieldConfig": { "defaults": {}, "overrides": [{ "matcher": { "id": "byName", "options": "Status" }, "properties": [{ "id": "custom.displayMode", "value": "color-background" }, { "id": "color", "value": { "mode": "thresholds" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }] }] }] }
    }
  ]
}